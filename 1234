  if(window.matchMedia('(hover:none)').matches)document.querySelectorAll('.mphoto').forEach(function(f){f.addEventListener('click',function(){f.classList.toggle('is-open')})});

  // Меню на телефоне
  var b=document.querySelector('.burger'),n=document.getElementById('nav');
  if(b&&n)b.addEventListener('click',function(){
    var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o);
  });

  // Видео: без движения при «уменьшить анимацию»
  var v=document.querySelector('.hero video');
  if(v&&window.matchMedia('(prefers-reduced-motion:reduce)').matches){v.removeAttribute('autoplay');v.pause()}

  // Карта и маршруты берут одни и те же координаты
  var f=document.getElementById('map');
  if(f){var ll=CLUB.lng+'%2C'+CLUB.lat;f.src='https://yandex.ru/map-widget/v1/?ll='+ll+'&z=16&pt='+ll+'%2Cpm2rdl'}
  document.querySelectorAll('[data-route]').forEach(function(a){
    a.href='https://yandex.ru/maps/?rtext=~'+CLUB.lat+'%2C'+CLUB.lng+'&rtt=auto';
  });

  // Появление блоков снизу вверх при прокрутке
  if(!('IntersectionObserver' in window))return;
  var io=new IntersectionObserver(function(l){
    l.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}});
  },{threshold:.15,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('main .wrap > *, .cards > *, .price li, .info > *').forEach(function(el){
    var i=Array.prototype.indexOf.call(el.parentNode.children,el);
    el.style.setProperty('--d',Math.min(i,4)*80+'ms');
    el.setAttribute('data-reveal','');
    io.observe(el);
  });
})();

