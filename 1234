(function(){
  var PAGES={"glavnaya": {"t": "Барбершоп «Борода» в Мытищах — стрижка от 1 500 ₽", "d": "Барбершоп «Борода» в Мытищах: мужские стрижки, борода, королевское бритьё. Запись по телефону, цены на сайте."}, "uslugi": {"t": "Услуги барбершопа «Борода» в Мытищах", "d": "Мужская стрижка, моделирование бороды, королевское бритьё, детская стрижка. Что входит в каждую услугу и сколько она длится."}, "ceny": {"t": "Цены на стрижки и бороду — барбершоп «Борода», Мытищи", "d": "Прайс барбершопа «Борода»: стрижка от 1 500 ₽, борода от 1 000 ₽, комплекс от 2 300 ₽. Точную цену мастер называет до начала."}, "mastera": {"t": "Мастера барбершопа «Борода» в Мытищах — Максим, Даниил, Олег, Роман", "d": "Четыре мастера барбершопа «Борода»: Максим, Даниил, Олег и Роман. Стаж, образование и специализация каждого."}, "o-nas": {"t": "О барбершопе «Борода» — мастера и подход", "d": "История барбершопа «Борода» в Мытищах, как мы работаем и почему к нам возвращаются."}, "kontakty": {"t": "Контакты и как добраться — барбершоп «Борода», Мытищи", "d": "Адрес, телефон, режим работы и карта проезда барбершопа «Борода» в Мытищах."}};
  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var metaEl=document.querySelector('meta[name=description]');
  var v=document.querySelector('.hero video');
  function blobUrl(id,mime){
    var el=document.getElementById(id);if(!el)return '';
    var b=atob(el.textContent.trim()),u=new Uint8Array(b.length);
    for(var i=0;i<b.length;i++)u[i]=b.charCodeAt(i);
    return URL.createObjectURL(new Blob([u],{type:mime}));
  }
  // Видео лежит внутри файла в двух форматах. Берём тот, что играет этот браузер
  if(v){
    var h264=v.canPlayType('video/mp4; codecs="avc1.42E01E"')!=='';
    var order=h264?[['vid-mp4','video/mp4'],['vid-webm','video/webm']]:[['vid-webm','video/webm'],['vid-mp4','video/mp4']];
    var k=0;
    var load=function(){
      if(k>=order.length)return;
      v.src=blobUrl(order[k][0],order[k][1]);k++;
      if(!reduce){var pr=v.play();if(pr&&pr.catch)pr.catch(function(){})}
    };
    v.addEventListener('error',load);
    if(reduce){v.removeAttribute('autoplay')}
    load();
  }
  function show(){
    var n=location.hash.slice(1);if(!PAGES[n])n='glavnaya';
    document.querySelectorAll('.page').forEach(function(p){p.hidden=(p.id!=='p-'+n)});
    document.title=PAGES[n].t;metaEl.setAttribute('content',PAGES[n].d);
    document.querySelectorAll('[data-nav]').forEach(function(a){
      var on=a.getAttribute('data-nav')===n;a.classList.toggle('is-active',on);
      if(on)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');
    });
    var nv=document.getElementById('nav'),bg=document.querySelector('.burger');
    if(nv)nv.classList.remove('open');if(bg)bg.setAttribute('aria-expanded','false');
    if(v){if(n==='glavnaya'){if(!reduce&&v.src){var pr=v.play();if(pr&&pr.catch)pr.catch(function(){})}}else{v.pause()}}
    window.scrollTo({top:0,behavior:'instant'});
  }
  window.addEventListener('hashchange',show);show();
})();
